# Directory on the host containing the Git repositories this team may inspect
# and modify. Relative paths are resolved from compose.yaml.
WORKSPACE_ROOT=..

# Optional display name. Local development derives this from the parent folder;
# set it for Docker when you want that host folder name shown exactly.
ENGINEERING_TEAM_PROJECT_NAME=

# Local browser port. The service remains bound to loopback.
ENGINEERING_TEAM_PORT=4318

# Optional local voice runs with: docker compose --profile voice up --build --detach
# Compose wires its internal speech endpoint automatically. For a separately
# started local development speech service, export ENGINEERING_TEAM_SPEECH_URL
# to its loopback HTTP URL before starting the API (never a cloud endpoint).
# Local speech output is a separate service in the same voice profile. Compose
# sets ENGINEERING_TEAM_TTS_URL automatically; native API development may point
# it at a separately started TTS service on loopback.
# Set COMPOSE_PROFILES=voice to include voice with ordinary `docker compose up`.
# CPU quotas default to 4 for transcription and 2 for synthesis. Set both to 0
# on a local Docker host that reports no CPU quota support. This disables only
# those quotas; Docker may also ignore memory/PID limits on such a host.
ENGINEERING_TEAM_SPEECH_CPUS=4
ENGINEERING_TEAM_TTS_CPUS=2

# Linux users should set these to the output of `id -u` and `id -g` so files
# created in mounted repositories remain owned by the host account.
ENGINEERING_TEAM_UID=1000
ENGINEERING_TEAM_GID=1000

# Required: generate a random 32-byte secret using the README startup command
# (or openssl rand -hex 32) and paste the value below. Compose supplies the same
# secret to the API and controller. Keep the existing value when upgrading.
# A controller started without a nonblank secret refuses to listen.
ENGINEERING_TEAM_CONTROLLER_TOKEN=

# Maximum concurrent workers across every project and run type, including
# harness probes. Must be a positive integer. Busy requests can be retried.
ENGINEERING_TEAM_MAX_WORKERS=2

# Host-level Codex ChatGPT login. Use an absolute path to the auth.json created
# by `codex login`. Never copy the credential file into this repository.
CODEX_AUTH_FILE=

# Optional alternatives for non-ChatGPT authentication.
OPENAI_API_KEY=
CODEX_API_KEY=
CODEX_ACCESS_TOKEN=

# Optional host directory containing AWS config, credentials, and SSO/login
# caches. It is mounted read-only into the trusted controller, never workers.
# Example: /home/you/.aws
AWS_CONFIG_DIR=
