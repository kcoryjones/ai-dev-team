# Directory on the host containing the Git repositories this team may inspect
# and modify. Relative paths are resolved from compose.yaml.
WORKSPACE_ROOT=..

# Optional display name. Local development derives this from the parent folder;
# set it for Docker when you want that host folder name shown exactly.
ENGINEERING_TEAM_PROJECT_NAME=

# Local browser port. The service remains bound to loopback.
ENGINEERING_TEAM_PORT=4318

# Linux users should set these to the output of `id -u` and `id -g` so files
# created in mounted repositories remain owned by the host account.
ENGINEERING_TEAM_UID=1000
ENGINEERING_TEAM_GID=1000

# Host-level Codex ChatGPT login. Use an absolute path to the auth.json created
# by `codex login`. Never copy the credential file into this repository.
CODEX_AUTH_FILE=

# Optional alternatives for non-ChatGPT authentication.
OPENAI_API_KEY=
CODEX_API_KEY=
CODEX_ACCESS_TOKEN=
